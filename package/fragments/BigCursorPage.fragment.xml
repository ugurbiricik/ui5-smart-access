<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
   <VBox id="saPageBigCursor" class="saPage saDetailPage saTpl" width="100%">
      <VBox class="saPreview saPreviewCursor" width="100%" renderType="Bare">
         <Text text="{i18n>detail.preview}" class="saPreviewLabel" />
         <HBox alignItems="Center" class="saPreviewCursorRow" renderType="Bare">
            <Image
               src="{parts: ['settings>/bigCursorColor', 'settings>/bigCursorCustomColor'], formatter: '.fmtBigCursorPreview'}"
               densityAware="false"
               decorative="true"
               class="saPreviewCursorImg" />
            <Text text="{i18n>detail.sample}" class="saPreviewSample" />
         </HBox>
      </VBox>

      <VBox class="saTplField" width="100%" renderType="Bare">
         <Label id="bigCursorColorLabel" text="{i18n>bigCursor.color}" class="saTplLabelRow" />
         <VBox class="saChipWrap" width="100%" renderType="Bare">
            <HBox class="saChipGrid" width="100%" renderType="Bare">
               <ToggleButton
                  text="{i18n>status.off}"
                  icon="sap-icon://decline"
                  pressed="{= ${settings>/bigCursorColor} === 'none'}"
                  press=".onBigCursorOff"
                  ariaDescribedBy="bigCursorColorLabel"
                  class="saChip" />
            </HBox>
            <HBox class="saChipGrid" width="100%" items="{settings>/bigCursorColors}" renderType="Bare">
               <ToggleButton
                  text="{settings>label}"
                  icon="{settings>preview}"
                  pressed="{= ${settings>key} === ${settings>/bigCursorColor}}"
                  press=".onBigCursorSelect"
                  ariaDescribedBy="bigCursorColorLabel"
                  class="saChip" />
            </HBox>
         </VBox>
      </VBox>

      <core:Fragment fragmentName="ui5-smart-access.fragments.DetailFooter" type="XML" />
   </VBox>
</core:FragmentDefinition>
