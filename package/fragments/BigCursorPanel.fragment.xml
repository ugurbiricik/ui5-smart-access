<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
   <Panel id="bigCursorPanel" expandable="false" width="auto" class="bigCursorPanel saNavRow">
      <headerToolbar>
         <OverflowToolbar active="true" press=".onNavToDetail" custom:page="bigCursor">
            <core:Icon src="sap-icon://cursor-arrow" size="20px" />
            <Title text="{i18n>bigCursor.title}" />
            <ToolbarSpacer />
            <core:Icon src="sap-icon://slim-arrow-right" size="14px" class="saNavChevron" decorative="true" />
         </OverflowToolbar>
      </headerToolbar>
   </Panel>
</core:FragmentDefinition>
