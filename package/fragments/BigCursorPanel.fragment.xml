<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
   <Panel id="bigCursorPanel" expandable="false" width="auto" class="bigCursorPanel saRow saNavRow">
      <headerToolbar>
         <Toolbar active="true" press=".onNavToDetail" custom:page="bigCursor" ariaLabelledBy="bigCursorTitle bigCursorStatus" class="saRowBar">
            <core:Icon src="sap-icon://cursor-arrow" size="20px" class="saRowIcon" decorative="true" />
            <VBox class="saRowTexts" renderType="Bare">
               <layoutData><ToolbarLayoutData shrinkable="true" /></layoutData>
               <Title id="bigCursorTitle" text="{i18n>bigCursor.title}" class="saRowTitle" wrapping="false" />
               <Text id="bigCursorStatus" text="{path: 'settings>/bigCursorColor', formatter: '.fmtBigCursorStatus'}" class="saRowStatus" wrapping="false" />
            </VBox>
            <ToolbarSpacer />
            <core:Icon src="sap-icon://slim-arrow-right" size="14px" class="saNavChevron" decorative="true" />
         </Toolbar>
      </headerToolbar>
   </Panel>
</core:FragmentDefinition>
