<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
   <VBox id="saPageBlueLightFilter" class="saPage saDetailPage saTpl" width="100%">
      <VBox class="saPreview saPreviewColors" width="100%" renderType="Bare">
         <Text text="{i18n>detail.preview}" class="saPreviewLabel" />
         <HBox class="saPreviewSpectrum" width="100%" renderType="Bare" />
         <Text text="{i18n>blueFilter.previewHint}" class="saTplHint" />
      </VBox>

      <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%" class="saDetailRow">
         <Label id="blueLightFilterSwitchLabel" text="{i18n>blueFilter.title}" labelFor="blueLightFilterSwitch" />
         <Switch id="blueLightFilterSwitch" state="{settings>/blueLightFilterActive}" change=".onBlueLightFilterSwitch" ariaLabelledBy="blueLightFilterSwitchLabel" />
      </HBox>

      <VBox class="saTplField" width="100%" renderType="Bare">
         <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%" class="saTplLabelRow">
            <Label id="blueLightFilterLevelLabel" text="{i18n>blueFilter.intensity}" labelFor="blueLightFilterSlider" />
            <Text id="blueLightFilterLevelValue" text="{path: 'settings>/blueLightFilterLevel', formatter: '.formatPercent'}" class="saTplValue" />
         </HBox>
         <HBox class="saSeg" width="100%">
            <ToggleButton text="{value: 25, formatter: '.formatPercent'}" pressed="{= ${settings>/blueLightFilterActive} &amp;&amp; ${settings>/blueLightFilterLevel} === 25}" press=".onBlueLightFilterPreset" custom:value="25" ariaDescribedBy="blueLightFilterLevelLabel" class="saSegItem">
               <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
            </ToggleButton>
            <ToggleButton text="{value: 50, formatter: '.formatPercent'}" pressed="{= ${settings>/blueLightFilterActive} &amp;&amp; ${settings>/blueLightFilterLevel} === 50}" press=".onBlueLightFilterPreset" custom:value="50" ariaDescribedBy="blueLightFilterLevelLabel" class="saSegItem">
               <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
            </ToggleButton>
            <ToggleButton text="{value: 75, formatter: '.formatPercent'}" pressed="{= ${settings>/blueLightFilterActive} &amp;&amp; ${settings>/blueLightFilterLevel} === 75}" press=".onBlueLightFilterPreset" custom:value="75" ariaDescribedBy="blueLightFilterLevelLabel" class="saSegItem">
               <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
            </ToggleButton>
            <ToggleButton text="{value: 100, formatter: '.formatPercent'}" pressed="{= ${settings>/blueLightFilterActive} &amp;&amp; ${settings>/blueLightFilterLevel} === 100}" press=".onBlueLightFilterPreset" custom:value="100" ariaDescribedBy="blueLightFilterLevelLabel" class="saSegItem">
               <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
            </ToggleButton>
         </HBox>
         <Slider id="blueLightFilterSlider" min="0" max="100" step="5" value="{settings>/blueLightFilterLevel}" change=".onBlueLightFilterSliderChange" width="100%" ariaLabelledBy="blueLightFilterLevelLabel blueLightFilterLevelValue" class="saTplSlider blueFilterSlider" />
      </VBox>

      <core:Fragment fragmentName="ui5-smart-access.fragments.DetailFooter" type="XML" />
   </VBox>
</core:FragmentDefinition>
