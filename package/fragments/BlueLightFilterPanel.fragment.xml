<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
   <Panel id="blueLightFilterPanel" expandable="true" expanded="{settings>/blueLightFilterExpanded}" width="auto" class="blueLightFilterPanel">
      <headerToolbar>
         <OverflowToolbar active="true" press=".onBlueLightFilterToolbarPress">
            <core:Icon src="sap-icon://light-mode" size="20px" />
            <Title id="blueLightFilterTitle" text="{i18n>blueFilter.activate}" />
         </OverflowToolbar>
      </headerToolbar>
      <content>
         <VBox justifyContent="Center" alignItems="Center" width="100%">
            <HBox alignItems="Center" width="200px" justifyContent="SpaceBetween">
               <Slider id="blueLightFilterSlider" min="0" max="100" step="1" value="{settings>/blueLightFilterLevel}" width="150px" change=".onBlueLightFilterSliderChange"/>
               <Button id="blueLightFilterResetButton" icon="sap-icon://refresh" press=".onBlueLightFilterReset" tooltip="{i18n>aria.resetBlueLightFilter}"/>
            </HBox>
         </VBox>
      </content>
   </Panel>
</core:FragmentDefinition>
