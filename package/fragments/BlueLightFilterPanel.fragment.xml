<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
   <Panel id="blueLightFilterPanel" expandable="false" width="auto" class="blueLightFilterPanel saRow saNavRow">
      <headerToolbar>
         <Toolbar active="true" press=".onNavToDetail" custom:page="blueLightFilter" ariaLabelledBy="blueLightFilterTitle blueLightFilterStatus" class="saRowBar">
            <core:Icon src="sap-icon://light-mode" size="20px" class="saRowIcon" decorative="true" />
            <VBox class="saRowTexts" renderType="Bare">
               <layoutData><ToolbarLayoutData shrinkable="true" /></layoutData>
               <Title id="blueLightFilterTitle" text="{i18n>blueFilter.title}" class="saRowTitle" wrapping="false" />
               <Text id="blueLightFilterStatus" text="{parts: ['settings>/blueLightFilterActive', 'settings>/blueLightFilterLevel'], formatter: '.fmtBlueLightFilterStatus'}" class="saRowStatus" wrapping="false" />
            </VBox>
            <ToolbarSpacer />
            <core:Icon src="sap-icon://slim-arrow-right" size="14px" class="saNavChevron" decorative="true" />
         </Toolbar>
      </headerToolbar>
   </Panel>
</core:FragmentDefinition>
