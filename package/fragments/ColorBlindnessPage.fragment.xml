<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
>
   <VBox id="saPageColorBlindness" class="saPage saDetailPage saTpl" width="100%">
      <VBox class="saPreview saPreviewColors" width="100%" renderType="Bare">
         <Text text="{i18n>detail.preview}" class="saPreviewLabel" />
         <HBox class="saPreviewSpectrum" width="100%" renderType="Bare" />
         <Text text="{i18n>colorBlindness.previewHint}" class="saTplHint" />
      </VBox>

      <VBox class="saTplField" width="100%" renderType="Bare">
         <Label id="colorBlindnessModeLabel" text="{i18n>colorBlindness.mode}" class="saTplLabelRow" />
         <List items="{settings>/colorBlindnessModes}" showSeparators="None" mode="None" backgroundDesign="Transparent" width="100%" ariaLabelledBy="colorBlindnessModeLabel" class="cbList">
            <CustomListItem type="Active" press=".onColorBlindnessSelect" highlight="{= ${settings>key} === ${settings>/colorBlindnessType} ? 'Information' : 'None'}" class="cbItem">
               <customData>
                  <core:CustomData key="sasel" value="{= ${settings>key} === ${settings>/colorBlindnessType} ? 'yes' : 'no'}" writeToDom="true" />
               </customData>
               <HBox alignItems="Center" width="100%" class="cbCard cbCardRow">
                  <Image src="{settings>icon}" width="36px" height="36px" densityAware="false" decorative="true" class="cbSwatch" />
                  <VBox class="cbTexts">
                     <layoutData><FlexItemData growFactor="1" /></layoutData>
                     <Text text="{settings>title}" class="cbTitle" />
                     <Text text="{settings>sub}" class="cbSub" />
                  </VBox>
                  <core:Icon src="sap-icon://accept" visible="{= ${settings>key} === ${settings>/colorBlindnessType}}" decorative="true" class="cbCheck" />
               </HBox>
            </CustomListItem>
         </List>
      </VBox>

      <VBox class="saTplField" width="100%" renderType="Bare" visible="{= ${settings>/colorBlindnessType} !== 'none'}">
         <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%" class="saTplLabelRow">
            <Label id="colorBlindnessIntensityLabel" text="{i18n>colorBlindness.intensity}" labelFor="colorBlindnessIntensitySlider" />
            <Text id="colorBlindnessIntensityValue" text="{path: 'settings>/colorBlindnessIntensity', formatter: '.formatPercent'}" class="saTplValue" />
         </HBox>
         <Slider id="colorBlindnessIntensitySlider" min="0" max="100" step="5" value="{settings>/colorBlindnessIntensity}" change=".onColorBlindnessIntensityChange" width="100%" ariaLabelledBy="colorBlindnessIntensityLabel colorBlindnessIntensityValue" class="saTplSlider" />
      </VBox>

      <core:Fragment fragmentName="ui5-smart-access.fragments.DetailFooter" type="XML" />
   </VBox>
</core:FragmentDefinition>
