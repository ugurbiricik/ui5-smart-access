<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
   <Panel id="contrastModePanel" expandable="false" width="auto" class="contrastModePanel saRow saNavRow">
      <headerToolbar>
         <Toolbar active="true" press=".onNavToDetail" custom:page="contrast" ariaLabelledBy="contrastModeTitle contrastModeStatus" class="saRowBar">
            <core:Icon src="sap-icon://paint-bucket" size="20px" class="saRowIcon" decorative="true" />
            <VBox class="saRowTexts" renderType="Bare">
               <layoutData><ToolbarLayoutData shrinkable="true" /></layoutData>
               <Title id="contrastModeTitle" text="{i18n>contrastMode.title}" class="saRowTitle" wrapping="false" />
               <Text id="contrastModeStatus" text="{parts: ['settings>/contrastModeActive', 'settings>/contrastTheme', 'settings>/contrastRatio', 'settings>/contrastBgColor', 'settings>/contrastTextColor'], formatter: '.fmtContrastStatus'}" class="saRowStatus" wrapping="false" />
            </VBox>
            <ToolbarSpacer />
            <core:Icon src="sap-icon://slim-arrow-right" size="14px" class="saNavChevron" decorative="true" />
         </Toolbar>
      </headerToolbar>
   </Panel>
</core:FragmentDefinition>
