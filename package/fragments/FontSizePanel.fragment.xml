<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
   <Panel id="fontSizePanel" expandable="false" width="auto" class="fontSizePanel saRow saNavRow">
      <headerToolbar>
         <Toolbar active="true" press=".onNavToDetail" custom:page="font" ariaLabelledBy="fontSizeTitle fontSizeStatus" class="saRowBar">
            <core:Icon src="sap-icon://text" size="20px" class="saRowIcon" decorative="true" />
            <VBox class="saRowTexts" renderType="Bare">
               <layoutData><ToolbarLayoutData shrinkable="true" /></layoutData>
               <Title id="fontSizeTitle" text="{i18n>fontSize.title}" class="saRowTitle" wrapping="false" />
               <Text id="fontSizeStatus" text="{parts: ['settings>/typoFontPct', 'settings>/typoZoom', 'settings>/typoLineHeight', 'settings>/typoWordSpacing', 'settings>/typoLetterSpacing', 'settings>/typoAlign'], formatter: '.fmtFontStatus'}" class="saRowStatus" wrapping="false" />
            </VBox>
            <ToolbarSpacer />
            <core:Icon src="sap-icon://slim-arrow-right" size="14px" class="saNavChevron" decorative="true" />
         </Toolbar>
      </headerToolbar>
   </Panel>
</core:FragmentDefinition>
