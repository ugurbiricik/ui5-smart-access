<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
   <Panel id="fontSizePanel" expandable="false" width="auto" class="fontSizePanel saNavRow">
      <headerToolbar>
         <OverflowToolbar active="true" press=".onNavToDetail" custom:page="font">
            <core:Icon src="sap-icon://text" size="20px" />
            <Title text="{i18n>fontSize.title}" />
            <ToolbarSpacer />
            <core:Icon src="sap-icon://slim-arrow-right" size="14px" class="saNavChevron" decorative="true" />
         </OverflowToolbar>
      </headerToolbar>
   </Panel>
</core:FragmentDefinition>
