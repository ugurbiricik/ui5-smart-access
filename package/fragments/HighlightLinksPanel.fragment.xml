<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
   <Panel id="highlightLinksPanel" expandable="false" width="auto" class="highlightLinksPanel saRow saToggleRow">
      <headerToolbar>
         <Toolbar active="true" press=".onFeatureRowPress" custom:feature="highlightLinks" ariaLabelledBy="highlightLinksTitle highlightLinksStatus" class="saRowBar">
            <core:Icon src="sap-icon://chain-link" size="20px" class="saRowIcon" decorative="true" />
            <VBox class="saRowTexts" renderType="Bare">
               <layoutData><ToolbarLayoutData shrinkable="true" /></layoutData>
               <Title id="highlightLinksTitle" text="{i18n>highlightLinks.title}" class="saRowTitle" wrapping="false" />
               <Text id="highlightLinksStatus" text="{path: 'settings>/highlightLinksActive', formatter: '.fmtToggleStatus'}" class="saRowStatus" wrapping="false" />
            </VBox>
            <ToolbarSpacer />
            <Switch id="highlightLinksSwitch" state="{path: 'settings>/highlightLinksActive', mode: 'OneWay'}" change=".onFeatureSwitchChange" custom:feature="highlightLinks" ariaLabelledBy="highlightLinksTitle" class="saRowSwitch" />
         </Toolbar>
      </headerToolbar>
   </Panel>
</core:FragmentDefinition>
