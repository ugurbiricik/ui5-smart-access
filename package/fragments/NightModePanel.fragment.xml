<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
   <Panel id="nightModePanel" expandable="false" width="auto" class="nightModePanel">
      <headerToolbar>
         <OverflowToolbar>
            <core:Icon src="sap-icon://dark-mode" size="20px" />
            <Title id="nightModeTitle" text="{i18n>nightMode.activate}" />
            <ToolbarSpacer />
            <Switch state="{settings>/nightModeActive}" change=".onNightModeToolbarPress" />
         </OverflowToolbar>
      </headerToolbar>
   </Panel>
</core:FragmentDefinition>
