<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
   <Panel id="readingGuidePanel" expandable="true" expanded="{settings>/readingGuideExpanded}" width="auto" class="readingGuidePanel">
      <headerToolbar>
         <OverflowToolbar active="true" press=".onReadingGuideToolbarPress">
            <core:Icon src="sap-icon://horizontal-grip" size="20px" />
            <Title text="{i18n>readingGuide.title}" />
         </OverflowToolbar>
      </headerToolbar>
      <content>
         <VBox justifyContent="Center" alignItems="Center" width="100%">
            <HBox alignItems="Center" width="200px" justifyContent="SpaceBetween">
               <Select id="readingGuideSelect" selectedKey="{settings>/readingGuideMode}" type="Default" change=".onReadingGuideChange">
                  <items>
                     <core:Item key="none" text="{i18n>readingGuide.none}" />
                     <core:Item key="guide" text="{i18n>readingGuide.guide}" />
                     <core:Item key="mask" text="{i18n>readingGuide.mask}" />
                  </items>
               </Select>
               <Button id="readingGuideResetButton" icon="sap-icon://refresh" press=".onReadingGuideReset" tooltip="{i18n>aria.resetReadingGuide}" class="cbIntBtn"/>
            </HBox>
         </VBox>
      </content>
   </Panel>
</core:FragmentDefinition>
