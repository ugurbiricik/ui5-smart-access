<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
>
   <VBox id="saPageShortcuts" class="saPage saDetailPage saShortcutsPage" width="100%">
      <Text id="saShortcutsIntro" text="{i18n>shortcuts.intro}" class="saTplHint saShortcutsIntro" />
      <List
         id="saShortcutsList"
         items="{settings>/shortcutRows}"
         showSeparators="Inner"
         ariaLabelledBy="saShortcutsIntro"
         class="saShortcutsList"
      >
         <CustomListItem type="Inactive" class="saShortcutItem">
            <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%" class="saShortcutRow" renderType="Bare">
               <Text text="{path: 'settings>titleKey', formatter: '.fmtShortcutTitle'}" wrapping="true" class="saShortcutLabel">
                  <layoutData><FlexItemData growFactor="1" shrinkFactor="1" /></layoutData>
               </Text>
               <Text text="{path: 'settings>code', formatter: '.fmtShortcutKeys'}" wrapping="false" class="saKbd">
                  <layoutData><FlexItemData shrinkFactor="0" /></layoutData>
               </Text>
            </HBox>
         </CustomListItem>
      </List>
      <HBox class="saDetailFooter" justifyContent="End" alignItems="Center" renderType="Bare">
         <Button text="{i18n>detail.done}" type="Emphasized" press=".onDetailDone" class="saFooterBtn saFooterDone" />
      </HBox>
   </VBox>
</core:FragmentDefinition>
