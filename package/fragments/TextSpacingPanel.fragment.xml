<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
   <Panel id="textSpacingPanel" expandable="true" expanded="{settings>/textSpacingExpanded}" width="auto" class="textSpacingPanel">
      <headerToolbar>
         <OverflowToolbar active="true" press=".onTextSpacingToolbarPress">
            <core:Icon src="sap-icon://text-align-justified" size="20px" />
            <Title text="{i18n>textSpacing.title}" />
         </OverflowToolbar>
      </headerToolbar>
      <content>
         <VBox justifyContent="Center" alignItems="Center" width="100%">
            <HBox alignItems="Center" width="200px" justifyContent="SpaceBetween">
               <Select id="textSpacingSelect" selectedKey="{settings>/textSpacingLevel}" type="Default" change=".onTextSpacingChange">
                  <items>
                     <core:Item key="none" text="{i18n>textSpacing.none}" />
                     <core:Item key="light" text="{i18n>textSpacing.light}" />
                     <core:Item key="moderate" text="{i18n>textSpacing.moderate}" />
                     <core:Item key="heavy" text="{i18n>textSpacing.heavy}" />
                  </items>
               </Select>
               <Button id="textSpacingResetButton" icon="sap-icon://refresh" press=".onTextSpacingReset" tooltip="{i18n>aria.resetTextSpacing}" class="cbIntBtn"/>
            </HBox>
         </VBox>
      </content>
   </Panel>
</core:FragmentDefinition>
