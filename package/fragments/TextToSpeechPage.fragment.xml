<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:custom="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
   <VBox id="saPageTts" class="saPage saDetailPage saTpl ttsFlyoutSection" width="100%">
      <VBox class="saPreview saPreviewTts" width="100%" renderType="Bare">
         <Text text="{i18n>detail.preview}" class="saPreviewLabel" />
         <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%" class="saPreviewTtsRow" renderType="Bare">
            <Text id="ttsSampleText" text="{i18n>detail.sample}" class="saPreviewSample" />
            <Button
               icon="sap-icon://sound-loud"
               text="{i18n>tts.sample}"
               press=".onTtsSample"
               enabled="{= !${settings>/ttsPlaying}}"
               ariaDescribedBy="ttsSampleText"
               class="saPreviewAction" />
         </HBox>
      </VBox>

      <HBox alignItems="Center" width="100%" justifyContent="Center" class="ttsPlayerBar">
         <Button icon="sap-icon://media-rewind" press=".onTTSPrev" tooltip="{i18n>tts.prev}" class="cbIntBtn" />
         <Button icon="{= ${settings>/ttsPlaying} ? 'sap-icon://media-pause' : 'sap-icon://media-play' }" press=".onTTSPlayPause" tooltip="{i18n>tts.playPause}" class="cbIntBtn ttsPlayBtn" />
         <Button icon="sap-icon://stop" press=".onTTSStop" tooltip="{i18n>tts.stop}" class="cbIntBtn" />
         <Button icon="sap-icon://media-forward" press=".onTTSNext" tooltip="{i18n>tts.next}" class="cbIntBtn" />
      </HBox>

      <VBox class="saTplField" width="100%" renderType="Bare">
         <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%" class="saTplLabelRow">
            <Label id="ttsRateLabel" text="{i18n>tts.speed}" labelFor="ttsRateSlider" />
            <Text id="ttsRateValue" text="{path: 'settings>/ttsRate', formatter: '.formatTtsRate'}" class="saTplValue" />
         </HBox>
         <HBox class="saSeg" width="100%">
            <ToggleButton text="{value: 0.75, formatter: '.formatTtsRate'}" pressed="{= ${settings>/ttsRate} === 0.75}" press=".onTtsRatePreset" custom:value="0.75" ariaDescribedBy="ttsRateLabel" class="saSegItem">
               <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
            </ToggleButton>
            <ToggleButton text="{value: 1, formatter: '.formatTtsRate'}" pressed="{= ${settings>/ttsRate} === 1}" press=".onTtsRatePreset" custom:value="1" ariaDescribedBy="ttsRateLabel" class="saSegItem">
               <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
            </ToggleButton>
            <ToggleButton text="{value: 1.25, formatter: '.formatTtsRate'}" pressed="{= ${settings>/ttsRate} === 1.25}" press=".onTtsRatePreset" custom:value="1.25" ariaDescribedBy="ttsRateLabel" class="saSegItem">
               <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
            </ToggleButton>
            <ToggleButton text="{value: 1.5, formatter: '.formatTtsRate'}" pressed="{= ${settings>/ttsRate} === 1.5}" press=".onTtsRatePreset" custom:value="1.5" ariaDescribedBy="ttsRateLabel" class="saSegItem">
               <layoutData><FlexItemData growFactor="1" baseSize="0" /></layoutData>
            </ToggleButton>
         </HBox>
         <Slider id="ttsRateSlider" min="0.5" max="2" step="0.05" value="{settings>/ttsRate}" change=".onTTSRateChange" width="100%" ariaLabelledBy="ttsRateLabel ttsRateValue" class="saTplSlider" />
      </VBox>

      <VBox class="saTplField" width="100%" renderType="Bare">
         <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%" class="saTplLabelRow">
            <Label id="ttsVolumeLabel" text="{i18n>tts.volume}" labelFor="ttsVolumeSlider" />
            <Text id="ttsVolumeValue" text="{path: 'settings>/ttsVolume', formatter: '.formatTtsVolume'}" class="saTplValue" />
         </HBox>
         <Slider id="ttsVolumeSlider" min="0" max="1" step="0.05" value="{settings>/ttsVolume}" change=".onTTSVolumeChange" width="100%" ariaLabelledBy="ttsVolumeLabel ttsVolumeValue" class="saTplSlider" />
      </VBox>

      <HBox alignItems="Center" width="100%" justifyContent="SpaceBetween" class="saDetailRow ttsHoverRow">
         <VBox renderType="Bare">
            <Label id="ttsHoverLabel" text="{i18n>tts.hover}" labelFor="ttsHoverSwitch" />
            <Text text="{i18n>tts.hoverHint}" class="saTplHint" />
         </VBox>
         <Switch id="ttsHoverSwitch" state="{settings>/ttsHover}" change=".onTTSHoverChange" ariaLabelledBy="ttsHoverLabel" />
      </HBox>

      <core:Fragment fragmentName="ui5-smart-access.fragments.DetailFooter" type="XML" />
   </VBox>
</core:FragmentDefinition>
