<mvc:View
	controllerName="test.controller.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core">

	<Page id="page" showHeader="false" showNavButton="false" class="sapUiResponsiveContentPadding">
		<content>
			<VBox class="demoPage" width="100%">

				<!-- ============ Hero ============ -->
				<VBox class="saHero">
					<!-- Decorative, always-running CSS animation (top-right). Pure @keyframes
					     so the assistant's "Animationen stoppen" feature freezes it. -->
					<core:HTML content='&lt;div class=&quot;saHeroAnim&quot; aria-hidden=&quot;true&quot;&gt;&lt;span class=&quot;saHeroAnimRing&quot;&gt;&lt;/span&gt;&lt;span class=&quot;saHeroAnimCore&quot;&gt;&lt;/span&gt;&lt;span class=&quot;saHeroAnimOrbit saHeroAnimOrbit1&quot;&gt;&lt;i&gt;&lt;/i&gt;&lt;/span&gt;&lt;span class=&quot;saHeroAnimOrbit saHeroAnimOrbit2&quot;&gt;&lt;i&gt;&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;' />

					<Image src="{/logoUrl}" densityAware="false" decorative="false" alt="abics" class="saHeroLogo" />

					<Title text="{i18n>appTitle}" level="H1" titleStyle="H1" class="saHeroTitle sapUiMediumMarginTop" />
					<Text text="{i18n>heroTagline}" class="saHeroTagline sapUiSmallMarginTop" />
					<Text text="{i18n>heroIntro}" class="saHeroIntro sapUiSmallMarginTop" />

					<HBox class="saHeroBadges sapUiMediumMarginTop" wrap="Wrap">
						<Text text="{i18n>badgeVersion}" class="saBadge" />
						<Text text="{i18n>badgeLicense}" class="saBadge" />
						<Text text="{i18n>badgeClient}" class="saBadge" />
					</HBox>

					<HBox class="sapUiMediumMarginTop" wrap="Wrap" alignItems="Center">
						<Link text="{i18n>linkNpm}" href="https://www.npmjs.com/package/ui5-smart-access" target="_blank" class="saHeroLink sapUiMediumMarginEnd" />
						<Link text="{i18n>linkGithub}" href="https://github.com/ugurbiricik/ui5-smart-access" target="_blank" class="saHeroLink sapUiMediumMarginEnd" />
						<Link text="abics.de" href="https://www.abics.de" target="_blank" class="saHeroLink" />
					</HBox>

					<MessageStrip text="{i18n>heroHint}" type="Information" showIcon="true" class="sapUiMediumMarginTop saHeroHint" />
				</VBox>

				<!-- ============ What is it ============ -->
				<VBox class="demoSection">
					<Title text="{i18n>whatTitle}" level="H2" titleStyle="H2" />
					<Text text="{i18n>whatP1}" class="sapUiSmallMarginTop" />
					<Text text="{i18n>whatP2}" class="sapUiSmallMarginTop" />
				</VBox>

				<!-- ============ Features ============ -->
				<VBox class="demoSection">
					<Title text="{i18n>featuresTitle}" level="H2" titleStyle="H2" />
					<Text text="{i18n>featuresIntro}" class="sapUiSmallMarginTop" />

					<l:Grid content="{/features}" defaultSpan="XL3 L3 M6 S12" hSpacing="1" vSpacing="1" class="featureGrid sapUiMediumMarginTop">
						<VBox class="featureCard">
							<core:Icon src="{icon}" size="1.75rem" class="featureCardIcon" />
							<Title text="{name}" level="H4" titleStyle="H4" wrapping="true" class="sapUiTinyMarginTop" />
							<Text text="{desc}" class="featureCardDesc sapUiTinyMarginTop" />
						</VBox>
					</l:Grid>
				</VBox>

				<!-- ============ Why accessibility (typography demo) ============ -->
				<VBox class="demoSection">
					<Title text="{i18n>whyTitle}" level="H2" titleStyle="H2" />
					<Text text="{i18n>whyP1}" class="sapUiSmallMarginTop" />
					<Text text="{i18n>whyP2}" class="sapUiSmallMarginTop" />
					<Text text="{i18n>whyP3}" class="sapUiSmallMarginTop" />

					<Link text="{i18n>whyLink}" href="https://www.w3.org/WAI/WCAG21/quickref/" target="_blank" class="sapUiSmallMarginTop" />

					<MessageStrip text="{i18n>whyMsgInfo}" type="Information" showIcon="true" class="sapUiMediumMarginTop" />
					<MessageStrip text="{i18n>whyMsgSuccess}" type="Success" showIcon="true" class="sapUiTinyMarginTop" />
					<MessageStrip text="{i18n>whyMsgWarning}" type="Warning" showIcon="true" class="sapUiTinyMarginTop" />
					<MessageStrip text="{i18n>whyMsgError}" type="Error" showIcon="true" class="sapUiTinyMarginTop" />
				</VBox>

				<!-- ============ Images ============ -->
				<VBox class="demoSection">
					<Title text="{i18n>imagesTitle}" level="H2" titleStyle="H2" />
					<Text text="{i18n>imagesHint}" class="sapUiSmallMarginTop" />

					<l:Grid defaultSpan="L4 M6 S12" class="sapUiMediumMarginTop" hSpacing="1" vSpacing="1">
						<Image src="https://picsum.photos/id/1067/400/250" densityAware="false" decorative="false" alt="Motiv 1" />
						<Image src="https://picsum.photos/id/1059/400/250" densityAware="false" decorative="false" alt="Motiv 2" />
						<Image src="https://picsum.photos/id/1043/400/250" densityAware="false" decorative="false" alt="Motiv 3" />
						<Image src="https://picsum.photos/id/1025/400/250" densityAware="false" decorative="false" alt="Motiv 4" />
						<Image src="https://picsum.photos/id/1024/400/250" densityAware="false" decorative="false" alt="Motiv 5" />
						<Image src="https://picsum.photos/id/1015/400/250" densityAware="false" decorative="false" alt="Motiv 6" />
					</l:Grid>
				</VBox>

				<!-- ============ Colors & contrast ============ -->
				<VBox class="demoSection">
					<Title text="{i18n>colorsTitle}" level="H2" titleStyle="H2" />
					<Text text="{i18n>colorsHint}" class="sapUiSmallMarginTop" />

					<HBox wrap="Wrap" class="sapUiMediumMarginTop">
						<core:HTML content='&lt;div style="width:7rem;height:5rem;background:#e74c3c;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:bold;margin:4px"&gt;Rot&lt;/div&gt;' />
						<core:HTML content='&lt;div style="width:7rem;height:5rem;background:#e67e22;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:bold;margin:4px"&gt;Orange&lt;/div&gt;' />
						<core:HTML content='&lt;div style="width:7rem;height:5rem;background:#f1c40f;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#000;font-weight:bold;margin:4px"&gt;Gelb&lt;/div&gt;' />
						<core:HTML content='&lt;div style="width:7rem;height:5rem;background:#2ecc71;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:bold;margin:4px"&gt;Grün&lt;/div&gt;' />
						<core:HTML content='&lt;div style="width:7rem;height:5rem;background:#3498db;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:bold;margin:4px"&gt;Blau&lt;/div&gt;' />
						<core:HTML content='&lt;div style="width:7rem;height:5rem;background:#9b59b6;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:bold;margin:4px"&gt;Lila&lt;/div&gt;' />
					</HBox>

					<Title text="{i18n>contrastTitle}" level="H3" titleStyle="H3" class="sapUiMediumMarginTop" />
					<Text text="{i18n>contrastHint}" class="sapUiSmallMarginTop" />
					<core:HTML content='&lt;div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px"&gt;&lt;div style="padding:16px;background:#fafafa;color:#7a7a7a;border-radius:6px;min-width:180px"&gt;Niedriger Kontrast: Grau auf Hellgrau&lt;/div&gt;&lt;div style="padding:16px;background:#ffffff;color:#000;border:1px solid #ddd;border-radius:6px;min-width:180px"&gt;Hoher Kontrast: Schwarz auf Weiß&lt;/div&gt;&lt;div style="padding:16px;background:#ffe066;color:#664d00;border-radius:6px;min-width:180px"&gt;Gelb auf Dunkelgelb&lt;/div&gt;&lt;/div&gt;' />
				</VBox>

			</VBox>
		</content>
	</Page>

	<!-- Floating accessibility launcher (fixed top-right, always visible) -->
	<Button
		id="accessFab"
		icon="sap-icon://accessibility"
		class="accessFab"
		press=".openAbicsAccessibilityPopover"
		tooltip="{i18n>openAccessibility}" />

</mvc:View>
